cabal-version:      3.0
name:               tank-battle
version:            0.1.0.0
synopsis:           Game xe tang nhieu nguoi choi theo luoi, client - server qua TCP / UDP
description:        Do an cuoi ky mon Lap trinh ham voi Haskell.
                    May chu giu GameState trong TVar, vong lap 30 FPS, hang doi lenh TChan,
                    do tim phong LAN qua UDP; client ve bang Gloss, luu tai khoan ra tep.
license:            BSD-3-Clause
author:             Nhom 5 thanh vien
maintainer:         student@university.edu.vn
category:           Game
build-type:         Simple

common shared-properties
    default-language:   Haskell2010
    default-extensions: BangPatterns
    if os(windows)
        extra-libraries: winmm, imm32
    ghc-options:        -Wall
                        -Wcompat
                        -Wincomplete-record-updates
                        -Wincomplete-uni-patterns
                        -Wredundant-constraints

library
    import:             shared-properties
    hs-source-dirs:     src
    exposed-modules:    Types
                      , Hero
                      , GameLogic
                      , Protocol
                      , ParserCombinator
                      , Server.State
                      , Server.Network
                      , Server.Tick
                      , Server.Supervisor
                      , Server.Launcher
                      , AI
                      , Client.Audio
                      , Client.UI
                      , Client.Account
                      , Client.Input
    build-depends:      base >= 4.14 && < 5
                      , bytestring >= 0.10
                      , containers >= 0.6
                      , network >= 3.1
                      , stm >= 2.5
                      , async >= 2.2
                      , random >= 1.2
                      , gloss >= 1.13
                      , directory >= 1.3
                      , filepath >= 1.4
                      , process >= 1.6

executable tank-server
    import:             shared-properties
    main-is:            Server/Main.hs
    hs-source-dirs:     src
    other-modules:      Types
                      , Hero
                      , GameLogic
                      , Protocol
                      , ParserCombinator
                      , Server.State
                      , Server.Network
                      , Server.Tick
                      , Server.Supervisor
                      , Server.Launcher
                      , AI
    build-depends:      base >= 4.14 && < 5
                      , bytestring >= 0.10
                      , containers >= 0.6
                      , network >= 3.1
                      , stm >= 2.5
                      , async >= 2.2
                      , random >= 1.2
                      , process >= 1.6
    ghc-options:        -threaded
                        -rtsopts
                        "-with-rtsopts=-N"

executable tank-client
    import:             shared-properties
    main-is:            Client/Main.hs
    hs-source-dirs:     src
    other-modules:      Types
                      , Hero
                      , GameLogic
                      , Protocol
                      , ParserCombinator
                      , Server.Network
                      , Server.State
                      , Server.Tick
                      , Server.Supervisor
                      , Server.Launcher
                      , AI
                      , Client.Audio
                      , Client.UI
                      , Client.Account
                      , Client.Input
    build-depends:      base >= 4.14 && < 5
                      , bytestring >= 0.10
                      , containers >= 0.6
                      , network >= 3.1
                      , stm >= 2.5
                      , async >= 2.2
                      , random >= 1.2
                      , gloss >= 1.13
                      , directory >= 1.3
                      , filepath >= 1.4
                      , process >= 1.6
    ghc-options:        -threaded
                        -rtsopts
                        "-with-rtsopts=-N"

test-suite tank-test
    import:             shared-properties
    type:               exitcode-stdio-1.0
    main-is:            Spec.hs
    hs-source-dirs:     test, src
    other-modules:      Types
                      , Hero
                      , GameLogic
                      , Protocol
                      , ParserCombinator
                      , AI
                      , Client.Account
                      , Client.Input
                      , Server.State
    build-depends:      base >= 4.14 && < 5
                      , bytestring >= 0.10
                      , containers >= 0.6
                      , network >= 3.1
                      , stm >= 2.5
                      , async >= 2.2
                      , random >= 1.2
                      , directory >= 1.3
                      , filepath >= 1.4
                      , process >= 1.6
                      , time >= 1.9
    ghc-options:        -threaded
                        -rtsopts
                        "-with-rtsopts=-N"
